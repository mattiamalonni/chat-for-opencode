{
  "name": "chat-for-opencode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.19",
  "publisher": "mattiamalonni",
  "license": "MIT",
  "author": "Mattia Malonni",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattiamalonni/chat-for-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/mattiamalonni/chat-for-opencode/issues"
  },
  "homepage": "https://github.com/mattiamalonni/chat-for-opencode#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "agent",
    "coding agent",
    "llm",
    "assistant"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%",
      "restrictedConfigurations": [
        "opencode.executablePath",
        "opencode.endpoint"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode",
          "title": "%container.title%",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "%view.chat%",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.newSession",
        "title": "%command.newSession%",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.openConfigFile",
        "title": "%command.openConfigFile%",
        "category": "OpenCode",
        "icon": "$(file-code)"
      },
      {
        "command": "opencode.openSettings",
        "title": "%command.openSettings%",
        "category": "OpenCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "opencode.restart",
        "title": "%command.restart%",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.compact",
        "title": "%command.compact%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.explainSelection",
        "title": "%command.explainSelection%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.findBugsSelection",
        "title": "%command.findBugsSelection%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.writeTestsSelection",
        "title": "%command.writeTestsSelection%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.optimizeSelection",
        "title": "%command.optimizeSelection%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.addFileToChat",
        "title": "%command.addFileToChat%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.searchSessions",
        "title": "%command.searchSessions%",
        "category": "OpenCode",
        "icon": "$(search)"
      },
      {
        "command": "opencode.focus",
        "title": "%command.focus%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.ask",
        "title": "%command.ask%",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "opencode.openChatInEditor",
        "title": "%command.openChatInEditor%",
        "category": "OpenCode",
        "icon": "$(link-external)"
      },
      {
        "command": "opencode.account",
        "title": "%command.account%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.showLogs",
        "title": "%command.showLogs%",
        "category": "OpenCode",
        "icon": "$(output)"
      },
      {
        "command": "opencode.setServerPassword",
        "title": "%command.setServerPassword%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.stopServer",
        "title": "%command.stopServer%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.moveView",
        "title": "%command.moveView%",
        "category": "OpenCode",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.openConfigFile",
          "when": "view == opencode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "opencode.restart",
          "when": "view == opencode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "opencode.openSettings",
          "when": "view == opencode.chatView",
          "group": "navigation@3"
        },
        {
          "command": "opencode.compact",
          "when": "view == opencode.chatView",
          "group": "overflow"
        },
        {
          "command": "opencode.showLogs",
          "when": "view == opencode.chatView",
          "group": "overflow"
        },
        {
          "command": "opencode.openChatInEditor",
          "when": "view == opencode.chatView",
          "group": "navigation@4"
        },
        {
          "command": "opencode.moveView",
          "when": "view == opencode.chatView",
          "group": "overflow"
        }
      ],
      "editor/context": [
        {
          "command": "opencode.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "opencode@1"
        },
        {
          "command": "opencode.addFileToChat",
          "when": "resourceScheme == file",
          "group": "opencode@2"
        },
        {
          "command": "opencode.explainSelection",
          "when": "editorHasSelection",
          "group": "opencode@3"
        },
        {
          "command": "opencode.findBugsSelection",
          "when": "editorHasSelection",
          "group": "opencode@4"
        },
        {
          "command": "opencode.writeTestsSelection",
          "when": "editorHasSelection",
          "group": "opencode@5"
        },
        {
          "command": "opencode.optimizeSelection",
          "when": "editorHasSelection",
          "group": "opencode@6"
        }
      ],
      "explorer/context": [
        {
          "command": "opencode.addFileToChat",
          "when": "resourceScheme == file",
          "group": "opencode@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.addSelectionToChat",
          "when": "editorHasSelection"
        },
        {
          "command": "opencode.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "opencode.findBugsSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "opencode.writeTestsSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "opencode.optimizeSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "opencode.ask"
        },
        {
          "command": "opencode.searchSessions"
        },
        {
          "command": "opencode.openChatInEditor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "opencode.ask",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o"
      },
      {
        "command": "opencode.searchSessions",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "opencode.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.executablePath": {
          "type": "string",
          "default": "opencode",
          "scope": "machine-overridable",
          "markdownDescription": "%config.executablePath%"
        },
        "opencode.endpoint": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.endpoint%"
        },
        "opencode.autoContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoContext%"
        },
        "opencode.dropzone": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.dropzone%"
        },
        "opencode.startupTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 2000,
          "markdownDescription": "%config.startupTimeout%"
        },
        "opencode.autoRestart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoRestart%"
        },
        "opencode.sessionPermissions": {
          "type": "array",
          "default": [
            {
              "action": "edit",
              "resource": "*",
              "effect": "ask"
            },
            {
              "action": "shell",
              "resource": "*",
              "effect": "ask"
            },
            {
              "action": "external_directory",
              "resource": "*",
              "effect": "ask"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "action",
              "resource",
              "effect"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "resource": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny",
                  "ask"
                ]
              }
            }
          },
          "markdownDescription": "%config.sessionPermissions%"
        },
        "opencode.autoApprovePermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoApprovePermissions%"
        },
        "opencode.notifyOnComplete": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.notifyOnComplete%"
        },
        "opencode.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifyOnFailure%"
        },
        "opencode.sessionPageSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "%config.sessionPageSize%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:prod",
    "compile": "npm run typecheck && node esbuild.mjs",
    "compile:prod": "npm run typecheck && node esbuild.mjs --production",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit && tsc -p test/ui --noEmit",
    "gen:types": "node scripts/gen-openapi-types.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "pretest": "npm run lint && npm run typecheck",
    "test": "npm run test:unit && npm run test:ui && npm run test:integration",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:ui && npm run test:integration",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "npm run compile && node -e \"require('node:fs').rmSync('coverage/ui', { recursive: true, force: true })\" && OC_COVERAGE=1 playwright test && node scripts/ui-coverage.mjs",
    "test:ui": "node esbuild.mjs && playwright test",
    "test:integration": "node esbuild.mjs && tsc -p test/integration && node out/test/integration/runTest.js",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "package": "vsce package",
    "test:integration:real": "node esbuild.mjs && tsc -p test/integration && OC_IT_REAL=1 node out/test/integration/runTest.js",
    "test:integration:e2e": "node esbuild.mjs && tsc -p test/integration && OC_IT_E2E=1 node out/test/integration/runTest.js",
    "test:integration:real:e2e": "node esbuild.mjs && tsc -p test/integration && OC_IT_REAL=1 OC_IT_E2E=1 node out/test/integration/runTest.js"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.65.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.99.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
