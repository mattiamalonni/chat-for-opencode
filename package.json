{
  "name": "chat-for-opencode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.4",
  "publisher": "mattiamalonni",
  "license": "MIT",
  "author": "Mattia Malonni",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattiamalonni/chat-for-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/mattiamalonni/chat-for-opencode/issues"
  },
  "homepage": "https://github.com/mattiamalonni/chat-for-opencode#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "agent",
    "coding agent",
    "llm",
    "assistant"
  ],
  "main": "./dist/extension.mjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%",
      "restrictedConfigurations": [
        "opencode.endpoint"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode",
          "title": "%container.title%",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "%view.chat%",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "opencode.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "trust",
            "title": "%walkthrough.trust.title%",
            "description": "%walkthrough.trust.description%",
            "command": "workbench.trust.manage",
            "commandTitle": "%walkthrough.trust.command%",
            "media": {
              "markdown": "media/walkthrough-trust.md"
            }
          },
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "command": "opencode.install",
            "commandTitle": "%walkthrough.install.command%",
            "media": {
              "markdown": "media/walkthrough-install.md"
            }
          },
          {
            "id": "provider",
            "title": "%walkthrough.provider.title%",
            "description": "%walkthrough.provider.description%",
            "command": "opencode.connect",
            "commandTitle": "%walkthrough.provider.command%",
            "media": {
              "markdown": "media/walkthrough-provider.md"
            }
          },
          {
            "id": "chat",
            "title": "%walkthrough.chat.title%",
            "description": "%walkthrough.chat.description%",
            "command": "opencode.chatView.focus",
            "commandTitle": "%walkthrough.chat.command%",
            "media": {
              "markdown": "media/walkthrough-chat.md"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "opencode.newSession",
        "title": "%command.newSession%",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.openSettings",
        "title": "%command.openSettings%",
        "category": "OpenCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "opencode.restart",
        "title": "%command.restart%",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.compact",
        "title": "%command.compact%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.searchSessions",
        "title": "%command.searchSessions%",
        "category": "OpenCode",
        "icon": "$(search)"
      },
      {
        "command": "opencode.stopTurn",
        "title": "%command.stopTurn%",
        "category": "OpenCode",
        "icon": "$(stop)"
      },
      {
        "command": "opencode.openChatInEditor",
        "title": "%command.openChatInEditor%",
        "category": "OpenCode",
        "icon": "$(link-external)"
      },
      {
        "command": "opencode.account",
        "title": "%command.account%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.connect",
        "title": "%command.connect%",
        "category": "OpenCode",
        "icon": "$(plug)"
      },
      {
        "command": "opencode.showLogs",
        "title": "%command.showLogs%",
        "category": "OpenCode",
        "icon": "$(output)"
      },
      {
        "command": "opencode.setServerPassword",
        "title": "%command.setServerPassword%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.stopServer",
        "title": "%command.stopServer%",
        "category": "OpenCode"
      },
      {
        "command": "opencode.moveView",
        "title": "%command.moveView%",
        "category": "OpenCode",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "opencode.install",
        "title": "%command.install%",
        "category": "OpenCode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.restart",
          "when": "view == opencode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "opencode.openSettings",
          "when": "view == opencode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "opencode.compact",
          "when": "view == opencode.chatView",
          "group": "overflow"
        },
        {
          "command": "opencode.showLogs",
          "when": "view == opencode.chatView",
          "group": "overflow"
        },
        {
          "command": "opencode.connect",
          "when": "view == opencode.chatView",
          "group": "navigation@3"
        },
        {
          "command": "opencode.openChatInEditor",
          "when": "view == opencode.chatView",
          "group": "navigation@4"
        },
        {
          "command": "opencode.moveView",
          "when": "view == opencode.chatView",
          "group": "overflow"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.searchSessions"
        },
        {
          "command": "opencode.install"
        },
        {
          "command": "opencode.connect"
        },
        {
          "command": "opencode.openChatInEditor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.searchSessions",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.endpoint": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.endpoint%"
        },
        "opencode.autoContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoContext%"
        },
        "opencode.dropzone": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.dropzone%"
        },
        "opencode.sessionPermissions": {
          "type": "array",
          "default": [
            {
              "action": "edit",
              "resource": "*",
              "effect": "ask"
            },
            {
              "action": "shell",
              "resource": "*",
              "effect": "ask"
            },
            {
              "action": "external_directory",
              "resource": "*",
              "effect": "ask"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "action",
              "resource",
              "effect"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "resource": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny",
                  "ask"
                ]
              }
            }
          },
          "markdownDescription": "%config.sessionPermissions%"
        },
        "opencode.autoApprovePermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoApprovePermissions%"
        },
        "opencode.notifyOnComplete": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.notifyOnComplete%"
        },
        "opencode.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifyOnFailure%"
        },
        "opencode.sessionPageSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "%config.sessionPageSize%"
        },
        "opencode.toolOutputLimit": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "maximum": 100000,
          "markdownDescription": "%config.toolOutputLimit%"
        },
        "opencode.promptLibrary": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.promptLibrary%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique slash-command id, without the leading slash."
              },
              "title": {
                "type": "string",
                "description": "Label shown in the / picker."
              },
              "description": {
                "type": "string",
                "description": "Short hint shown under the label."
              },
              "text": {
                "type": "string",
                "description": "Prompt text. Supports $selection, $file, $diff and $problems."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:prod && npm run gen:vscodeignore",
    "compile": "npm run typecheck && node esbuild.mjs",
    "compile:prod": "npm run typecheck && node esbuild.mjs --production",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit && tsc -p test/ui --noEmit && tsc -p test/integration --noEmit",
    "gen:types": "node scripts/gen-openapi-types.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:vscodeignore": "node scripts/gen-vscodeignore.mjs",
    "verify:vscodeignore": "node scripts/gen-vscodeignore.mjs --check",
    "verify:docs": "node scripts/gen-docs.mjs --check",
    "verify:links": "node scripts/check-doc-links.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "audit:high": "npm audit --omit=dev --audit-level=high",
    "verify:types": "npm run gen:types && git diff --exit-code -- src/shared/openapi.generated.ts",
    "pretest": "npm run lint && npm run format:check && npm run typecheck",
    "test": "npm run test:unit && npm run test:ui && npm run test:integration",
    "verify": "npm run audit && npm run verify:types && npm run verify:docs && npm run verify:vscodeignore && npm run verify:links && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:coverage:ui && npm run test:ui:prod && npm run test:integration && npm run test:integration:embedded",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "npm run compile && npm run test:coverage:ui:ci",
    "test:coverage:ui:ci": "node -e \"require('node:fs').rmSync('coverage/ui', { recursive: true, force: true })\" && cross-env OC_COVERAGE=1 playwright test && node scripts/ui-coverage.mjs",
    "test:ui:prod": "npm run compile:prod && cross-env OC_PROD_BUNDLE=1 playwright test test/ui/prod.spec.ts",
    "test:ui": "node esbuild.mjs && playwright test",
    "test:integration": "node esbuild.mjs && tsc -p test/integration && node out/test/integration/runTest.js",
    "test:integration:embedded": "node esbuild.mjs && tsc -p test/integration && cross-env OC_IT_SUITE=embedded.test.js node out/test/integration/runTest.js",
    "test:e2e": "npm run compile && vitest run --config vitest.e2e.config.mts",
    "package": "vsce package",
    "test:integration:real": "node esbuild.mjs && tsc -p test/integration && cross-env OC_IT_REAL=1 node out/test/integration/runTest.js",
    "test:integration:e2e": "node esbuild.mjs && tsc -p test/integration && cross-env OC_IT_E2E=1 node out/test/integration/runTest.js",
    "test:integration:real:e2e": "node esbuild.mjs && tsc -p test/integration && cross-env OC_IT_REAL=1 OC_IT_E2E=1 node out/test/integration/runTest.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@opencode/client": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.65.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.134.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
