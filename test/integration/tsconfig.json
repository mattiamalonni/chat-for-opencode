{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2022"],
    "types": ["node", "mocha", "vscode"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "outDir": "../../out"
  },
  "include": ["./**/*.ts", "../mock/mockServer.ts"]
}
