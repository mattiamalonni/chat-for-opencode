{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "baseUrl": ".",
    "paths": {
      "@opencode/sdk": ["./node_modules/@opencode/sdk/dist/index.d.ts"],
      "@opencode/client": ["./node_modules/@opencode/client/dist/promise/index.d.ts"]
    },
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/unit/**/*.ts", "test/mock/**/*.ts", "test/e2e/**/*.ts"],
  "exclude": ["src/webview/**", "node_modules", "dist", "out"]
}
